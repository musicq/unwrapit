{
  "name": "unwrapit",
  "version": "3.0.1",
  "description": "Turn throwing sync/async functions and promises into typed Result values with one tiny TypeScript API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./rxjs": {
      "types": "./dist/rxjs.d.ts",
      "require": "./dist/rxjs.cjs",
      "import": "./dist/rxjs.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musicq/unwrapit.git"
  },
  "homepage": "https://unwrapit-js.vercel.app/",
  "bugs": {
    "url": "https://github.com/musicq/unwrapit/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts src/rxjs.ts --dts --minify --format cjs,esm --clean",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:run && npm run typecheck:run",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "vitest --typecheck",
    "typecheck:run": "vitest --typecheck --run"
  },
  "keywords": [
    "typescript",
    "javascript",
    "result",
    "result-type",
    "error-handling",
    "errors-as-values",
    "try-catch",
    "promise",
    "rust",
    "rxjs",
    "functional-programming"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "musicq <kui.liang.sg@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "rxjs": "^7.8.1"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "panicit": "^2.0.1"
  }
}
